<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TV + Console Preview</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

        body {
            background: #0a0a1f;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px;
            gap: 30px;
        }

        .tv-container {
            width: 820px;
            background: #111;
            border: 28px solid #1a1a1a;
            border-radius: 18px;
            box-shadow: 0 0 60px rgba(0,0,0,0.9);
            padding: 18px;
        }

        .tv-bezel {
            background: #0f0f0f;
            border: 8px solid #222;
            border-radius: 8px;
            padding: 20px 24px 28px;
            position: relative;
        }

        .screen {
            background: #000;
            border: 12px solid #1a1a1a;
            height: 420px;
            position: relative;
            overflow: hidden;
            box-shadow: inset 0 0 60px rgba(0,0,0,0.95);
        }

        .scanlines {
            position: absolute;
            inset: 0;
            background: repeating-linear-gradient(
                to bottom,
                transparent 0px,
                transparent 3px,
                rgba(255,255,255,0.06) 3px,
                rgba(255,255,255,0.06) 4px
            );
            pointer-events: none;
            z-index: 2;
        }

        .guide-header {
            position: absolute;
            top: 22px;
            left: 0;
            right: 0;
            text-align: center;
            z-index: 3;
        }

        .guide-header-text {
            font-family: 'Press Start 2P', cursive;
            color: #39ff14;
            font-size: 22px;
            text-shadow: 0 0 10px #39ff14;
            letter-spacing: 2px;
        }

        .guide-line {
            height: 4px;
            background: #39ff14;
            margin: 10px auto 0;
            width: 82%;
            box-shadow: 0 0 12px #39ff14;
        }

        .no-signal {
            position: absolute;
            bottom: 32px;
            left: 36px;
            font-family: 'Press Start 2P', cursive;
            color: #00ffff;
            font-size: 18px;
            line-height: 1.35;
            text-shadow: 0 0 8px #00ffff;
            z-index: 3;
        }

        .right-indicators {
            position: absolute;
            right: -52px;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            gap: 18px;
            z-index: 4;
        }

        .indicator {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #111;
            border: 5px solid #333;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Press Start 2P', cursive;
            font-size: 11px;
            color: #ffcc00;
            box-shadow: 0 0 12px rgba(0,0,0,0.8);
        }

        .indicator.active {
            border-color: #ffcc00;
            box-shadow: 0 0 16px #ffcc00;
        }

        /* Console */
        .console {
            width: 820px;
            background: linear-gradient(#222, #1a1a1a);
            border: 18px solid #111;
            border-radius: 12px;
            padding: 22px 26px;
            box-shadow: 0 0 40px rgba(0,0,0,0.8);
            position: relative;
        }

        .console-top {
            height: 48px;
            background: #1a1a1a;
            border-radius: 6px;
            margin-bottom: 18px;
            position: relative;
            border: 4px solid #333;
        }

        .cartridge-slot {
            position: absolute;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            width: 220px;
            height: 26px;
            background: #0a0a0a;
            border: 4px solid #555;
            border-radius: 3px;
        }

        .console-body {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .console-label {
            color: #666;
            font-size: 13px;
            font-family: 'Press Start 2P', cursive;
        }

        .console-buttons {
            display: flex;
            gap: 14px;
        }

        .console-button {
            width: 48px;
            height: 48px;
            background: #c41e3a;
            border: 5px solid #111;
            border-radius: 6px;
            box-shadow: 0 4px 0 #111;
        }

        .console-led {
            width: 14px;
            height: 14px;
            background: #39ff14;
            border-radius: 50%;
            box-shadow: 0 0 12px #39ff14;
            position: absolute;
            top: 22px;
            right: 32px;
        }
    </style>
</head>
<body>

    <!-- TV -->
    <div class="tv-container">
        <div class="tv-bezel">
            <div class="screen">
                <div class="scanlines"></div>

                <!-- Guide Header -->
                <div class="guide-header">
                    <div class="guide-header-text">UHF 0 • UHF GUIDE</div>
                    <div class="guide-line"></div>
                </div>

                <!-- No Signal -->
                <div class="no-signal">
                    NO SIGNAL<br>
                    CHANNEL OFF AIR
                </div>
            </div>

            <!-- Right Side Indicators -->
            <div class="right-indicators">
                <div class="indicator active">VHF</div>
                <div class="indicator">UHF</div>
            </div>
        </div>
    </div>

    <!-- Console -->
    <div class="console">
        <div class="console-top">
            <div class="cartridge-slot"></div>
        </div>
        
        <div class="console-body">
            <div class="console-label">RETRO-8</div>
            
            <div class="console-buttons">
                <div class="console-button"></div>
                <div class="console-button" style="background:#1e3ac4;"></div>
            </div>
        </div>

        <div class="console-led"></div>
    </div>

</body>
</html>